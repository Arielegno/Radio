0,2274]"><node index="0" text="La división del trabajo es la especialización de las tareas en la sociedad moderna. Durkheim estudió la división del trabajo y la anomia en las sociedades industriales." resource-id="" class="android.widget.TextView" package="com.hilo.lector" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[47,63][1033,240]" /><node index="1" text="La sociología del conocimiento es la disciplina que estudia las relaciones entre el pensamiento humano y el contexto social en que se origina. El capitalismo condiciona las ideas de cada época." resource-id="" class="android.widget.TextView" package="com.hilo.lector" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[47,247][1033,567]" /><node index="2" text="Según Marx, el capitalismo es un sistema económico basado en la propiedad privada de los medios de producción. El capitalismo produce clases sociales enfrentadas por el control de la riqueza." resource-id="" class="android.widget.TextView" package="com.hilo.lector" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[47,574][1033,894]" /><node index="3" text="Se entiende por ideología el conjunto de ideas que expresan los intereses de una clase social. La ideología oculta las relaciones de dominación propias del capitalismo." resource-id="" class="android.widget.TextView" package="com.hilo.lector" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[47,901][1033,1221]" /><node index="4" text="En otras palabras, nos hemos limitado a hechos que, por así decir, se han agrupado bajo el estandarte de la sociología del conocimiento. Esto ha servido para destacar muy claramente un hecho." resource-id="" class="android.widget.TextView" package="com.hilo.lector" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[47,1228][1033,1548]" /><node index="5" text="La división del trabajo es la especialización de las tareas en la sociedad moderna. Durkheim estudió la división del trabajo y la anomia en las sociedades industriales." resource-id="" class="android.widget.TextView" package="com.hilo.lector" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[47,1555][1033,1875]" /><node index="6" text="Capítulo 2. Institucionalización y sociedad" resource-id="" class="android.widget.TextView" package="com.hilo.lector" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[47,1882][1033,2046]" /><node index="7" text="La institucionalización aparece cada vez que se da una tipificación recíproca de acciones habitualizadas. Las instituciones controlan el comportamiento humano en la sociedad." resource-id="" class="android.widget.TextView" package="com.hilo.lector" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[47,2079][1033,2274]" /></node></node></node></node></node></node></hierarchy>